        "CFG": "TRUE",
        "CODE": "rcp.Execute := RUN;\nrcp.START := RUN;\nrcp.HOLD := FALSE;\nrcp.RESET := FALSE;\nrcp.PV := PV;\nrcp.CycleTime := 0.1;\nrcp.PidOut := PIDOUT;\nrcp.AutoTune := FALSE;\nrcp.TrendEn := TRUE;\nrcp.TrendDepth := 256;\nrcp.TrigSeg := 2;\nIF NOT loaded THEN\n    rcp.PresetKp := 2.0; rcp.PresetTn := 60.0; rcp.PresetTv := 0.0;\n    rcp.nseg := 4;\n    rcp.SEG[1].KIND := 2; rcp.SEG[1].TGT := 180.0;\n    rcp.SEG[1].P1 := 2.0; rcp.SEG[1].P2 := 0.0;\n    rcp.SEG[2].KIND := 1; rcp.SEG[2].TGT := 180.0;\n    rcp.SEG[2].P1 := 600.0; rcp.SEG[2].P2 := 2.0; rcp.SEG[2].EV := 1;\n    rcp.SEG[3].KIND := 2; rcp.SEG[3].TGT := 25.0;\n    rcp.SEG[3].P1 := 0.8; rcp.SEG[3].P2 := 0.0;\n    rcp.SEG[4].KIND := 1; rcp.SEG[4].TGT := 25.0;\n    rcp.SEG[4].P1 := 300.0; rcp.SEG[4].P2 := 0.0; rcp.SEG[4].EV := 2;\n    rcp.SEG[5].KIND := 0;\n    loaded := TRUE;\nEND_IF;\nrcp();\nSP := rcp.SP;\nKP := rcp.Kp; TN := rcp.Tn; TV := rcp.Tv;\nOUTV := rcp.Out;\nDONE := rcp.Done;\nPH := rcp.Phase;\nTRACK := rcp.PidTrack;\nTRACKV := rcp.PidTrackVal;\n"
       },
