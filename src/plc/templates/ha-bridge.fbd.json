        "CODE": "br.Execute := CFG;\nbr.CycleTime := 0.1;\nIF NOT loaded THEN\n    br.Dev := 'oven';\n    br.Host := 'homeassistant.local';\n    br.Port := 1883;\n    br.HbS := 30;\n    br.CHAN[1].En := TRUE;  br.CHAN[1].Kind := 0;\n    br.CHAN[1].ObjId := 'boiler_temp'; br.CHAN[1].Name := 'Boiler temperature';\n    br.CHAN[1].Unit := 'degC'; br.CHAN[1].DevCls := 'temperature';\n    br.CHAN[2].En := TRUE;  br.CHAN[2].Kind := 2;\n    br.CHAN[2].ObjId := 'circulation_pump'; br.CHAN[2].Name := 'Circulation pump';\n    br.CHAN[2].AutoWr := TRUE;\n    br.CHAN[3].En := TRUE;  br.CHAN[3].Kind := 3;\n    br.CHAN[3].ObjId := 'boiler_setpoint'; br.CHAN[3].Name := 'Boiler setpoint';\n    br.CHAN[3].Unit := 'degC'; br.CHAN[3].MinV := 0.0; br.CHAN[3].MaxV := 300.0;\n    br.CHAN[3].AutoWr := TRUE;\n    loaded := TRUE;\nEND_IF;\nbr.CHAN[1].Value := TEMP;\nbr();\nPUMP := br.CHAN[2].BVal;\nSP := br.CHAN[3].Value;\nEVT := br.CHAN[2].Event OR br.CHAN[3].Event;\n"
